package com.multisite.studio;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.Button;
import android.widget.EditText;
import android.widget.GridLayout;
import android.widget.LinearLayout;
import android.widget.TextView;
import android.widget.Toast;

import java.util.ArrayList;

public class MainActivity extends Activity {

    private final ArrayList<WebView> webViews = new ArrayList<>();
    private GridLayout gridLayout;
    private EditText urlInput;
    private int siteCount = 4;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(8, 8, 8, 8);
        root.setBackgroundColor(Color.WHITE);

        TextView heading = new TextView(this);
        heading.setText("MULTISITE STUDIO");
        heading.setTextSize(22);
        heading.setTextColor(Color.BLACK);
        heading.setGravity(Gravity.CENTER);
        root.addView(heading);

        urlInput = new EditText(this);
        urlInput.setHint("Enter website URL");
        urlInput.setSingleLine(true);
        root.addView(urlInput);

        LinearLayout controls = new LinearLayout(this);
        controls.setOrientation(LinearLayout.HORIZONTAL);

        Button openAll = new Button(this);
        openAll.setText("Open All");
        openAll.setOnClickListener(v -> openAllSites());

        Button refreshAll = new Button(this);
        refreshAll.setText("Refresh All");
        refreshAll.setOnClickListener(v -> {
            for (WebView web : webViews) {
                web.reload();
            }
        });

        controls.addView(openAll, new LinearLayout.LayoutParams(0, -2, 1));
        controls.addView(refreshAll, new LinearLayout.LayoutParams(0, -2, 1));
        root.addView(controls);

        gridLayout = new GridLayout(this);
        gridLayout.setColumnCount(2);
        gridLayout.setRowCount(2);

        root.addView(gridLayout, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));

        setContentView(root);

        createWebViews();
    }

    private void createWebViews() {
        gridLayout.removeAllViews();
        webViews.clear();

        int columns = siteCount <= 4 ? 2 : 4;
        gridLayout.setColumnCount(columns);
        gridLayout.setRowCount((siteCount + columns - 1) / columns);

        for (int i = 0; i < siteCount; i++) {
            LinearLayout cell = new LinearLayout(this);
            cell.setOrientation(LinearLayout.VERTICAL);
            cell.setBackgroundColor(Color.LTGRAY);

            TextView label = new TextView(this);
            label.setText("Website " + (i + 1));
            label.setTextColor(Color.BLACK);
            label.setGravity(Gravity.CENTER);
            cell.addView(label);

            WebView web = new WebView(this);
            web.getSettings().setJavaScriptEnabled(true);
            web.getSettings().setDomStorageEnabled(true);
            web.setWebViewClient(new WebViewClient());

            cell.addView(web, new LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));

            GridLayout.LayoutParams params = new GridLayout.LayoutParams();
            params.width = 0;
            params.height = 0;
            params.columnSpec = GridLayout.spec(i % columns, 1f);
            params.rowSpec = GridLayout.spec(i / columns, 1f);
            params.setMargins(2, 2, 2, 2);

            gridLayout.addView(cell, params);
            webViews.add(web);
        }
    }

    private void openAllSites() {
        String url = urlInput.getText().toString().trim();

        if (url.isEmpty()) {
            Toast.makeText(this, "Enter a website URL", Toast.LENGTH_SHORT).show();
            return;
        }

        if (!url.startsWith("http://") && !url.startsWith("https://")) {
            url = "https://" + url;
        }

        for (WebView web : webViews) {
            web.loadUrl(url);
        }
    }
}
